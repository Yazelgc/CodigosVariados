  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_I2C1_Init();
  MX_I2C2_Init();
  MX_SPI1_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  HAL_I2C_Mem_Read(&hi2c1, dirBMI, CHIPID,1,&ChipCheck,1,100);
  HAL_I2C_Mem_Write(&hi2c1,dirBMI,turnon_bmi,1,&turnon_accel,1,100);//encender accel
  HAL_Delay(8);
  HAL_I2C_Mem_Write(&hi2c1,dirBMI,turnon_bmi,1,&turnon_gyro,1,100);//encender gyro
  HAL_Delay(80);
  HAL_I2C_Mem_Write(&hi2c1,dirBMI,cmd_accel_pmu,1,&cmd_25hz,1,100);//25 hz accel
  HAL_I2C_Mem_Write(&hi2c1,dirBMI,cmd_gyro_pmu,1,&cmd_25hz,1,100);//25 hz gyro
  HAL_I2C_Mem_Write(&hi2c1, dirBMI, cmd_rango_accel, 1, &val_16g, 1, 100); // Set a +-16g
  Bmi=1;
  /* USER CODE END 2 */
  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	HAL_Delay(500);
	HAL_I2C_Mem_Read_IT(&hi2c1, dirBMI, dirData,1,(uint8_t *)&DataBmi,12);
	if (Leyo==1){
		Leyo=0;
		LecturaBmi();
	}  }
  /* USER CODE END 3 */
}

