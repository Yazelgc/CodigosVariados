/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */
typedef struct __attribute__((packed)) {
    uint8_t  sync[2];          // 0xAA, 0x55
    uint16_t packet_id;
    uint32_t timestamp_ms;     // HAL_GetTick()
    float    altitude;         // metros AGL
    float    velocity;         // m/s magnitud
    float    pressure;         // hPa
    int16_t  temperature;      // °C × 100 (SHT40)
    uint16_t humidity;         // % × 100  (SHT40)
    int32_t  latitude;         // grados × 1e6
    int32_t  longitude;        // grados × 1e6
    uint8_t  gps_sats;
    int16_t  accel_x;          // g × 1000
    int16_t  accel_y;
    int16_t  accel_z;
    uint8_t  stage;            // 0=ESPERA, 1=ASCENSO, etc.
    uint8_t  battery;          // 0-100 %
    uint8_t  flags;            // bitmask
    uint16_t alt_max;
    uint16_t velocity_max;     // m/s × 10
    int16_t  temp_min;         // °C × 100
    uint32_t uptime_s;
    uint8_t  reserved[10];     // Reservado para SPS30 / Sensores adicionales
    uint16_t crc16;            // CRC-16/CCITT de bytes 0-61
} TelemetryPacket_t;
/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define SHT40_I2C_ADDR                    (0x44 << 1)
#define SHT40_CMD_MEASURE_HIGH_PRECISION  0xFD
/* USER CODE END PD */

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;

/* USER CODE BEGIN PV */
float temperatura_celsius = 0.0f;
float humedad_relativa = 0.0f;

// Instancia global del paquete de telemetría y contador
TelemetryPacket_t pkt;
uint16_t packet_counter = 0;
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
uint16_t crc16_ccitt(const uint8_t *buffer, size_t length);

/* USER CODE BEGIN 0 */
// Algoritmo CRC16-CCITT (Polinomio 0x1021)
uint16_t crc16_ccitt(const uint8_t *buffer, size_t length) {
    uint16_t crc = 0xFFFF;
    for (size_t i = 0; i < length; i++) {
        crc ^= ((uint16_t)buffer[i] << 8);
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x8000) {
                crc = (crc << 1) ^ 0x1021;
            } else {
                crc <<= 1;
            }
        }
    }
    return crc;
}
/* USER CODE END 0 */

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */
  // Limpiar paquete al inicio
  memset(&pkt, 0, sizeof(TelemetryPacket_t));
  pkt.sync[0] = 0xAA;
  pkt.sync[1] = 0x55;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      uint8_t cmd = SHT40_CMD_MEASURE_HIGH_PRECISION;
      uint8_t rx_buf[6];

      // 1. Lectura del SHT40 por I2C
      if (HAL_I2C_Master_Transmit(&hi2c1, SHT40_I2C_ADDR, &cmd, 1, 100) == HAL_OK)
      {
        HAL_Delay(10);

        if (HAL_I2C_Master_Receive(&hi2c1, SHT40_I2C_ADDR, rx_buf, 6, 100) == HAL_OK)
        {
          // 2. Reconstrucción de ticks y cálculo flotante
          uint16_t t_ticks = (uint16_t)(rx_buf[0] << 8) | rx_buf[1];
          temperatura_celsius = -45.0f + (175.0f * ((float)t_ticks / 65535.0f));

          uint16_t rh_ticks = (uint16_t)(rx_buf[3] << 8) | rx_buf[4];
          humedad_relativa = -6.0f + (125.0f * ((float)rh_ticks / 65535.0f));

          if (humedad_relativa < 0.0f) {
            humedad_relativa = 0.0f;
          } else if (humedad_relativa > 100.0f) {
            humedad_relativa = 100.0f;
          }

          // 3. ASIGNACIÓN AL PAQUETE DE TELEMETRÍA (Escalado de datos)
          pkt.temperature = (int16_t)(temperatura_celsius * 100.0f); // 22.40 °C -> 2240
          pkt.humidity    = (uint16_t)(humedad_relativa * 100.0f);   // 45.10 %  -> 4510
        }
      }

      // 4. Actualizar metadatos de telemetría del paquete
      pkt.packet_id    = packet_counter++;
      pkt.timestamp_ms = HAL_GetTick();
      pkt.uptime_s     = HAL_GetTick() / 1000;

      // 5. Calcular CRC16 sobre los primeros 62 bytes
      pkt.crc16 = crc16_ccitt((uint8_t*)&pkt, 62);

      // 6. AQUÍ ENVÍAS EL PAQUETE COMPLETO DE 64 BYTES
      // Ejemplo UART: HAL_UART_Transmit(&huart1, (uint8_t*)&pkt, sizeof(pkt), 100);

      HAL_Delay(1000);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

