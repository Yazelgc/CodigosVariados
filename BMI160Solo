void LecturaBmi(){
int16_t AccelXRaw= (int16_t)(DataBmi.accelraw[1]<<8 | DataBmi.accelraw[0]);
int16_t AccelYRaw= (int16_t)(DataBmi.accelraw[3]<<8 | DataBmi.accelraw[2]);
int16_t AccelZRaw= (int16_t)(DataBmi.accelraw[5]<<8 | DataBmi.accelraw[4]);
int16_t GyroXRaw= (int16_t)(DataBmi.gyroraw[1]<<8 | DataBmi.gyroraw[0]);
int16_t GyroYRaw= (int16_t)(DataBmi.gyroraw[3]<<8 | DataBmi.gyroraw[2]);
int16_t GyroZRaw= (int16_t)(DataBmi.gyroraw[5]<<8 | DataBmi.gyroraw[4]);

Gyro[0] = GyroXRaw / 16.4f;
    Gyro[1] = GyroYRaw / 16.4f;
    Gyro[2] = GyroZRaw / 16.4f;

    Accel[0] = AccelXRaw / 2048.0f;
    Accel[1] = AccelYRaw / 2048.0f;
    Accel[2] = AccelZRaw / 2048.0f;

}
